            Color = "bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400"
        },

        new()
        {
            Icon = "💰",
            Title = "Pago recibido",
            Description = "Pago de $2,450 recibido correctamente.",
            Time = "Hace 12 min",
            Color = "bg-green-50 text-green-600 dark:bg-green-500/10 dark:text-green-400"
        },

        new()
        {
            Icon = "📦",
            Title = "Inventario actualizado",
            Description = "Stock actualizado automáticamente.",
            Time = "Hace 38 min",
            Color = "bg-orange-50 text-orange-600 dark:bg-orange-500/10 dark:text-orange-400"
        },

        new()
        {
            Icon = "👥",
            Title = "Nuevo cliente agregado",
