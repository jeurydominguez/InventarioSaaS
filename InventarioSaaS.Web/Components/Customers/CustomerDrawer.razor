@using InventarioSaaS.Web.Models.Customers
@using InventarioSaaS.Web.Services

@inject CustomerService CustomerService
@inject NotificationStateService NotificationState

@if (Open)
{
    <!-- OVERLAY -->
    <div class="
        fixed inset-0
        z-40
        bg-black/40
        backdrop-blur-sm
        "
         @onclick="Close">
    </div>

    <!-- DRAWER -->
    <div class="
        fixed
        top-0
        right-0
        z-50

        h-screen
        w-full
        sm:w-[520px]

        bg-surface
        dark:bg-darkSurface

        border-l
        border-borderColor
        dark:border-darkBorder

        shadow-2xl

        flex
        flex-col
        ">

        <!-- HEADER -->
        <div class="
            px-8 py-6

            border-b
            border-borderColor
            dark:border-darkBorder">

            <div class="flex items-center justify-between">

                <div>

                    <h2 class="
                        text-3xl
                        font-bold

                        text-textPrimary
                        dark:text-darkTextPrimary">

                        Nuevo cliente

                    </h2>

                    <p class="
                        mt-2

                        text-textMuted
                        dark:text-darkTextMuted">

                        Agrega un nuevo cliente.

                    </p>

                </div>

                <button @onclick="Close"
                        class="
                    w-12 h-12
                    rounded-2xl

                    hover:bg-surfaceSoft
                    dark:hover:bg-darkSurfaceSoft">

                    ✕

                </button>

            </div>

        </div>

        <!-- BODY -->
        <div class="
            flex-1
            overflow-auto

            px-8 py-8

            space-y-6">

            <!-- NOMBRE -->
            <div>

                <label class="
                    block
                    mb-3

                    text-sm
                    font-semibold">

                    Nombre

                </label>

                <input @bind="Model.Nombre"
                       placeholder="Juan Pérez"
                       class="input-style" />

            </div>

            <!-- TELEFONO -->
            <div>

                <label class="
                    block
                    mb-3

                    text-sm
                    font-semibold">

                    Número telefónico

                </label>

                <input @bind="Model.NumeroTelefono"
                       placeholder="809-000-0000"
                       class="input-style" />

            </div>

            <!-- DIRECCION -->
            <div>

                <label class="
                    block
                    mb-3

                    text-sm
                    font-semibold">

                    Dirección

                </label>

                <textarea @bind="Model.Direccion"
                          rows="4"
                          placeholder="Dirección del cliente..."
                          class="input-style">
                </textarea>

            </div>

        </div>

        <!-- FOOTER -->
        <div class="
            px-8 py-6

            border-t
            border-borderColor
            dark:border-darkBorder

            flex justify-end gap-4">

            <button @onclick="Close"
                    class="
                h-14
                px-6

                rounded-2xl

                bg-surfaceSoft
                dark:bg-darkSurfaceSoft">

                Cancelar

            </button>

            <button @onclick="Save"
                    class="
                h-14
                px-7

                rounded-2xl

                bg-primary

                text-white
                font-semibold">

                Guardar cliente

            </button>

        </div>

    </div>
}


@code {

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private CreateCustomerDto Model = new();

    private async Task Save()
    {
        var success =
            await CustomerService.CrearCliente(Model);

        NotificationState.Notify();

        if (success)
        {
            Model = new();

            await OnSaved.InvokeAsync();

            await Close();
        }
    }

    private async Task Close()
    {
        await OpenChanged.InvokeAsync(false);
    }
}