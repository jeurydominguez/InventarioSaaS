@if (Open)
{
    <!-- OVERLAY -->
    <div class="
        fixed inset-0
        z-40

        bg-black/40

        backdrop-blur-sm

        animate-fade
        "
         @onclick="Close">
    </div>

    <!-- DRAWER -->
    <div class="
        fixed
        top-0
        right-0
        z-50

        h-screen
        w-[520px]

        bg-surface
        dark:bg-darkSurface

        border-l
        border-borderColor
        dark:border-darkBorder

        shadow-2xl

        flex
        flex-col

        animate-slide
        ">

        <!-- HEADER -->
        <div class="
            px-8
            py-6

            border-b
            border-borderColor
            dark:border-darkBorder
            ">

            <div class="flex items-start justify-between">

                <div>

                    <h2 class="
                        text-3xl
                        font-bold

                        text-textPrimary
                        dark:text-darkTextPrimary
                        ">
                        Nueva factura
                    </h2>

                    <p class="
                        mt-2
                        text-textMuted
                        dark:text-darkTextMuted
                        ">
                        Crea una nueva factura rápidamente.
                    </p>

                </div>

                <!-- CLOSE -->
                <button @onclick="Close"
                        class="
                    w-12 h-12

                    rounded-2xl

                    hover:bg-surfaceSoft
                    dark:hover:bg-darkSurfaceSoft

                    transition-all
                    ">

                    ✕

                </button>

            </div>

        </div>

        <!-- BODY -->
        <div class="
            flex-1
            overflow-auto

            px-8
            py-8

            space-y-6
            ">

            <!-- CLIENT -->
            <div>

                <label class="
                    block
                    mb-3

                    text-sm
                    font-semibold

                    text-textPrimary
                    dark:text-darkTextPrimary
                    ">
                    Cliente
                </label>

                <input placeholder="Nombre del cliente"
                       class="
                w-full
                h-14

                px-5

                rounded-2xl

                bg-surfaceSoft
                dark:bg-darkSurfaceSoft

                border
                border-borderColor
                dark:border-darkBorder

                outline-none

                focus:border-primary

                transition-all
                " />

            </div>

            <!-- EMAIL -->
            <div>

                <label class="
                    block
                    mb-3

                    text-sm
                    font-semibold

                    text-textPrimary
                    dark:text-darkTextPrimary
                    ">
                    Email
                </label>

                <input placeholder="cliente@email.com"
                       class="
                w-full
                h-14

                px-5

                rounded-2xl

                bg-surfaceSoft
                dark:bg-darkSurfaceSoft

                border
                border-borderColor
                dark:border-darkBorder

                outline-none

                focus:border-primary

                transition-all
                " />

            </div>

            <!-- TOTAL -->
            <div>

                <label class="
                    block
                    mb-3

                    text-sm
                    font-semibold

                    text-textPrimary
                    dark:text-darkTextPrimary
                    ">
                    Total
                </label>

                <input placeholder="$0.00"
                       class="
                w-full
                h-14

                px-5

                rounded-2xl

                bg-surfaceSoft
                dark:bg-darkSurfaceSoft

                border
                border-borderColor
                dark:border-darkBorder

                outline-none

                focus:border-primary

                transition-all
                " />

            </div>

            <!-- NOTES -->
            <div>

                <label class="
                    block
                    mb-3

                    text-sm
                    font-semibold

                    text-textPrimary
                    dark:text-darkTextPrimary
                    ">
                    Notas
                </label>

                <textarea rows="5"
                          placeholder="Escribe una nota..."
                          class="
                w-full

                px-5 py-4

                rounded-2xl

                bg-surfaceSoft
                dark:bg-darkSurfaceSoft

                border
                border-borderColor
                dark:border-darkBorder

                outline-none

                focus:border-primary

                transition-all
                ">
            </textarea>

        </div>

    </div>

    <!-- FOOTER -->
    <div class="
        px-8
        py-6

        border-t
        border-borderColor
        dark:border-darkBorder

        flex
        items-center
        justify-end
        gap-4
        ">

        <!-- CANCEL -->
        <button @onclick="Close"
                class="
            h-14
            px-6

            rounded-2xl

            bg-surfaceSoft
            dark:bg-darkSurfaceSoft

            font-semibold

            text-textPrimary
            dark:text-darkTextPrimary

            transition-all
            ">

            Cancelar

        </button>

        <!-- SAVE -->
        <button class="
            h-14
            px-7

            rounded-2xl

            bg-primary
            hover:bg-primary-dark

            text-white
            font-semibold

            shadow-glow

            transition-all
            hover:scale-105
            ">

            Crear factura

        </button>

    </div>

</div>
}

@code {

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    private async Task Close()
    {
        Open = false;

        await OpenChanged.InvokeAsync(false);
    }

}