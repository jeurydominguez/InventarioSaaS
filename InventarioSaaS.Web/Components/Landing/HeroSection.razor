@using InventarioSaaS.Web.Components.Dashboard
@inject NavigationManager Navigation
<section class="
    relative
    overflow-hidden
    pt-32 pb-24
    px-4 sm:px-6 lg:px-8
    ">

    <!-- BACKGROUND GLOW -->
    <div class="
        absolute top-0 left-1/2
        -translate-x-1/2
        w-[900px] h-[900px]
        bg-primary/10
        blur-[120px]
        rounded-full
        pointer-events-none
        ">
    </div>

    <div class="relative max-w-7xl mx-auto">

        <!-- HERO CONTENT -->
        <div class="text-center max-w-4xl mx-auto animate-fade-up">

            <!-- BADGE -->
            <div class="
                inline-flex items-center gap-2
                px-4 py-2
                rounded-full
                bg-indigo-50
                border border-indigo-100
                text-primary
                text-sm
                font-semibold
                mb-8
                ">

                ✨ Nueva experiencia Zentra Business 2026

            </div>

            <!-- TITLE -->
            <h1 class="
                text-4xl
                sm:text-5xl
                lg:text-7xl
                font-black
                tracking-tight
                text-textPrimary
                leading-tight
                ">

                La forma más fácil de gestionar

                <span class="text-primary">
                    tu negocio
                </span>

            </h1>

            <!-- DESCRIPTION -->
            <p class="
                mt-8
                text-lg sm:text-xl
                text-textMuted
                leading-relaxed
                max-w-2xl
                mx-auto
                ">

                Facturación, inventario, clientes y reportes
                financieros en una plataforma moderna diseñada
                para empresas que quieren crecer.

            </p>

            <!-- ACTIONS -->
            <div class="
                mt-10
                flex flex-col sm:flex-row
                justify-center
                gap-4
                ">

                <AppButton>
                    Comenzar gratis
                </AppButton>

                <AppButton Variant="secondary">
                    Ver demo
                </AppButton>

            </div>

            <!-- METRICS -->
            <div class="
                mt-16
                grid grid-cols-2 md:grid-cols-4
                gap-6
                ">

                <div>

                    <h3 class="text-3xl font-bold text-textPrimary">
                        +12K
                    </h3>

                    <p class="text-textMuted mt-2">
                        Facturas procesadas
                    </p>

                </div>

                <div>

                    <h3 class="text-3xl font-bold text-textPrimary">
                        99.9%
                    </h3>

                    <p class="text-textMuted mt-2">
                        Disponibilidad
                    </p>

                </div>

                <div>

                    <h3 class="text-3xl font-bold text-textPrimary">
                        +340
                    </h3>

                    <p class="text-textMuted mt-2">
                        Empresas activas
                    </p>

                </div>

                <div>

                    <h3 class="text-3xl font-bold text-textPrimary">
                        24/7
                    </h3>

                    <p class="text-textMuted mt-2">
                        Soporte premium
                    </p>

                </div>

            </div>

        </div>

        <!-- DASHBOARD PREVIEW -->
        <div class="mt-24 relative animate-fade-up">

            <!-- GLOW -->
            <div class="
                absolute inset-0
                bg-primary/10
                blur-3xl
                rounded-full
                ">
            </div>

            <!-- WINDOW -->
            <div class="
                relative
                bg-white/80
                glass-effect
                border border-white/40
                rounded-[40px]
                shadow-2xl
                overflow-hidden
                ">

                <!-- TOPBAR -->
                <div class="
                    h-16
                    border-b border-borderColor
                    flex items-center
                    px-6
                    gap-2
                    bg-white/60
                    ">

                    <div class="w-3 h-3 rounded-full bg-red-400"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                    <div class="w-3 h-3 rounded-full bg-green-400"></div>

                </div>

                <!-- CONTENT -->
                <div class="grid lg:grid-cols-4 min-h-[650px]">

                    <!-- SIDEBAR -->
                    <div class="
                        hidden lg:block
                        bg-sidebar
                        p-6
                        border-r border-white/10
                        ">

                        <div class="text-white text-2xl font-black">
                            Zentra Business
                        </div>

                        <div class="mt-10 space-y-2">

                            <div class="
                                bg-white/10
                                rounded-2xl
                                px-4 py-3
                                text-white
                                ">

                                Dashboard

                            </div>

                            <div class="
                                rounded-2xl
                                px-4 py-3
                                text-white/70
                                ">

                                Facturas

                            </div>

                            <div class="
                                rounded-2xl
                                px-4 py-3
                                text-white/70
                                ">

                                Inventario

                            </div>

                            <div class="
                                rounded-2xl
                                px-4 py-3
                                text-white/70
                                ">

                                Reportes

                            </div>

                        </div>

                    </div>

                    <!-- MAIN -->
                    <div class="lg:col-span-3 p-6 sm:p-8 bg-background">

                        <!-- TOP -->
                        <div class="
                            flex flex-col sm:flex-row
                            sm:items-center
                            sm:justify-between
                            gap-4
                            ">

                            <div>

                                <h2 class="text-3xl font-bold text-textPrimary">
                                    Dashboard
                                </h2>

                                <p class="text-textMuted mt-2">
                                    Resumen financiero de tu empresa.
                                </p>

                            </div>

                            <AppButton>
                                Nueva factura
                            </AppButton>

                        </div>

                        <!-- STATS -->
                        <div class="
                            grid
                            grid-cols-1
                            md:grid-cols-2
                            2xl:grid-cols-4
                            gap-6
                            ">

                            <KpiCard Title="Ventas"
                                     Value="$24,780"
                                     Trend="+12.4%"
                                     Icon="💰" />

                            <KpiCard Title="Facturas"
                                     Value="152"
                                     Trend="+8.1%"
                                     Icon="🧾" />

                            <KpiCard Title="Clientes"
                                     Value="28"
                                     Trend="+18.2%"
                                     Icon="👥" />

                            <KpiCard Title="Productos"
                                     Value="894"
                                     Trend="+5.4%"
                                     Icon="📦" />

                        </div>

                        <!-- CHART -->
                        <div>

                            <RevenueChart />

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>