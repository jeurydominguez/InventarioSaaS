<div class="
    bg-surface
    border border-borderColor
    rounded-[32px]
    shadow-soft
    p-6
    hover-lift
    animate-fade-up
    ">

    <p class="text-gray-500 text-sm">
        @Title
    </p>

    <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 mt-3">
        @Value
    </h3>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;
}