@using InventarioSaaS.Web.Models
<div class="@GetClasses()">

    <!-- ICON -->
    <div class="text-xl">

        @GetIcon()

    </div>

    <!-- CONTENT -->
    <div class="flex-1">

        <h4 class="font-semibold text-sm">
            @Toast.Title
        </h4>

        <p class="text-sm opacity-80 mt-1">
            @Toast.Message
        </p>

    </div>

</div>

@code {

    [Parameter]
    public ToastModel Toast { get; set; } = default!;

    private string GetClasses()
    {
        var baseClasses =
            @"w-full
              flex items-start gap-4
              p-5 rounded-3xl
              shadow-2xl
              backdrop-blur-xl
              border
              animate-toast-in";

        return Toast.Variant switch
        {
            "error" =>
                $"{baseClasses} bg-red-500 text-white border-red-400",

            "warning" =>
                $"{baseClasses} bg-yellow-500 text-white border-yellow-400",

            _ =>
                $"{baseClasses} bg-sidebar text-white border-white/10"
        };
    }

    private string GetIcon()
    {
        return Toast.Variant switch
        {
            "error" => "❌",
            "warning" => "⚠️",
            _ => "✅"
        };
    }
}