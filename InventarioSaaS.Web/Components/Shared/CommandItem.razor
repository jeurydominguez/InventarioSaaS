<button class="
    w-full
    flex items-center gap-4
    px-4 py-4
    rounded-2xl
    hover:bg-surfaceSoft
    transition-all
    text-left
    ">

    <div class="
        w-12 h-12
        rounded-2xl
        bg-surfaceSoft
        flex items-center justify-center
        text-lg
        ">

        @Icon

    </div>

    <div>

        <p class="font-semibold text-textPrimary">
            @Title
        </p>

        <p class="text-sm text-textMuted mt-1">
            @Description
        </p>

    </div>

</button>

@code {

    [Parameter]
    public string Icon { get; set; } = "";

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Description { get; set; } = "";
}