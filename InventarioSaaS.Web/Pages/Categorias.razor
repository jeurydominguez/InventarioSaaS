@page "/categorias"
@attribute [Authorize]
@layout DashboardLayout

@using InventarioSaaS.Web.Components.Categories
@using InventarioSaaS.Web.Models.Categories
@using InventarioSaaS.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

@inject CategoryService CategoryService

<div class="space-y-8">

    <!-- HEADER -->
    <div class="
        flex
        flex-col
        lg:flex-row
        lg:items-center
        lg:justify-between
        gap-6">

        <div>

            <h1 class="
                text-4xl
                font-bold
                text-textPrimary
                dark:text-darkTextPrimary">

                Categorías

            </h1>

            <p class="
                mt-2
                text-textMuted
                dark:text-darkTextMuted">

                Gestiona las categorías de productos.

            </p>

        </div>

        <button @onclick="OpenCreate"
                class="
            h-14
            px-6

            rounded-2xl

            bg-primary
            hover:bg-primary-dark

            text-white
            font-semibold

            transition-all
            hover:scale-[1.02]

            shadow-glow">

            + Nueva categoría

        </button>

    </div>

    <!-- STATS -->
    <div class="
        grid
        grid-cols-1
        sm:grid-cols-2
        xl:grid-cols-3
        gap-6">

        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft">

            <p class="
                text-sm
                text-textMuted
                dark:text-darkTextMuted">

                Total categorías

            </p>

            <h3 class="
                mt-4
                text-4xl
                font-bold
                text-textPrimary
                dark:text-darkTextPrimary">

                @Categories.Count

            </h3>

        </div>

    </div>

    <!-- GRID -->
    <div class="
        grid
        grid-cols-1
        md:grid-cols-2
        xl:grid-cols-3
        gap-6">

        @foreach (var category in Categories)
        {
            <div class="
                group

                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[32px]

                p-8

                shadow-soft

                hover:-translate-y-1
                hover:shadow-xl

                transition-all">

                <!-- TOP -->
                <div class="
                    flex
                    items-start
                    justify-between">

                    <div>

                        <h2 class="
                            text-2xl
                            font-bold

                            text-textPrimary
                            dark:text-darkTextPrimary">

                            @category.Nombre

                        </h2>

                        <p class="
                            mt-3

                            text-textMuted
                            dark:text-darkTextMuted">

                            @category.Descripcion

                        </p>

                    </div>

                    <AuthorizeView Policy="admin">
                    <!-- MENU -->
                    <div class="
                        opacity-0
                        group-hover:opacity-100
                        transition-all
                        flex gap-2">

                        <button @onclick="() => OpenEdit(category)"
                                class="
                            w-10 h-10
                            rounded-xl

                            hover:bg-surfaceSoft
                            dark:hover:bg-darkSurfaceSoft">

                            ✏️

                        </button>

                        <button @onclick="() => ConfirmDelete(category)"
                                class="
                            w-10 h-10
                            rounded-xl

                            hover:bg-red-500/10">

                            🗑️

                        </button>

                    </div>
                    </AuthorizeView>

                </div>

            </div>
        }

    </div>

</div>

<CategoryDrawer
    @bind-Open="OpenDrawer"
    IsEditing="IsEditing"
    CreateModel="CreateModel"
    EditModel="EditModel"
    OnSaved="Load" />

@code {

    private List<CategoryDto> Categories = [];

    private bool OpenDrawer;

    private bool IsEditing;

    private CreateCategoryDto CreateModel = new();

    private EditCategoryDto EditModel = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        Categories =
            await CategoryService
                .ObtenerCategorias();
    }

    private void OpenCreate()
    {
        IsEditing = false;

        CreateModel = new();

        OpenDrawer = true;
    }

    private void OpenEdit(CategoryDto category)
    {
        IsEditing = true;

        EditModel = new EditCategoryDto
        {
            Id = category.Id,
            Nombre = category.Nombre,
            Descripcion = category.Descripcion
        };

        OpenDrawer = true;
    }

    private async Task ConfirmDelete(CategoryDto category)
    {
        var confirm =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Eliminar la categoría '{category.Nombre}'?");

        if (!confirm)
            return;

        var success =
            await CategoryService
                .Eliminar(category.Id);

        if (success)
        {
            await Load();
        }
    }

}