@page "/inventario"
@attribute [Authorize]
@layout DashboardLayout
@using InventarioSaaS.Web.Components.Inventory
@using InventarioSaaS.Web.Services
@using InventarioSaaS.Web.Models.Products
@inject CategoryService CategoryService
@using InventarioSaaS.Web.Models.Categories
@using Microsoft.AspNetCore.Authorization

@inject ProductService ProductService
@inject NotificationStateService NotificationState
<div class="space-y-8">

    <!-- HEADER -->
    <div class="
        flex
        flex-col
        lg:flex-row
        lg:items-center
        lg:justify-between

        gap-6
        ">

        <!-- LEFT -->
        <div>

            <h1 class="
                text-4xl
                font-bold

                text-textPrimary
                dark:text-darkTextPrimary
                ">
                Inventario
            </h1>

            <p class="
                mt-2

                text-textMuted
                dark:text-darkTextMuted
                ">
                Gestiona productos, stock y categorías.
            </p>

        </div>

        <!-- RIGHT -->
        <div class="
            flex
            flex-col
            sm:flex-row
            items-stretch
            sm:items-center
            gap-4
            w-full
            lg:w-auto
            ">

            <!-- SEARCH -->
            <div class="
                flex items-center gap-3

                h-14
                w-full
                sm:w-[320px]

                px-5

                rounded-2xl

                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder
                ">

                🔍
                <input @bind="Search"
                       @bind:event="oninput"
                       @bind:after="LoadProducts"
                       placeholder="Buscar producto..."
                       class="
                bg-transparent
                outline-none
                flex-1
                text-textPrimary
                dark:text-darkTextPrimary" />

            </div>

            <!-- BUTTON -->
            <button @onclick="() => OpenProductDrawer = true"
                    class="
                h-14
                px-6

                rounded-2xl

                bg-primary
                hover:bg-primary-dark

                text-white
                font-semibold

                whitespace-nowrap

                transition-all
                hover:scale-[1.02]

                shadow-glow
                ">

                + Nuevo producto

            </button>

        </div>

    </div>

    <!-- STATS -->
    <div class="
        grid
        grid-cols-1
        sm:grid-cols-2
        xl:grid-cols-4

        gap-6
        ">

        <!-- CARD -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft
            ">

            <p class="
                text-sm

                text-textMuted
                dark:text-darkTextMuted
                ">
                Productos
            </p>

            <h3 class="
                mt-4

                text-4xl
                font-bold

                text-textPrimary
                dark:text-darkTextPrimary
                ">
                @Stats.TotalProductos
            </h3>

        </div>

        <!-- CARD -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft
            ">

            <p class="
                text-sm

                text-textMuted
                dark:text-darkTextMuted
                ">
                Stock bajo
            </p>

            <h3 class="
                mt-4

                text-4xl
                font-bold

                text-orange-500
                ">
                @Stats.StockBajo
            </h3>

        </div>

        <!-- CARD -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft
            ">

            <p class="
                text-sm

                text-textMuted
                dark:text-darkTextMuted
                ">
                Categorías
            </p>

            <h3 class="
                mt-4

                text-4xl
                font-bold

                text-textPrimary
                dark:text-darkTextPrimary
                ">
                @Stats.TotalCategorias
            </h3>

        </div>

        <!-- CARD -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft
            ">

            <p class="
                text-sm

                text-textMuted
                dark:text-darkTextMuted
                ">
                Valor inventario
            </p>

            <h3 class="
                mt-4

                text-4xl
                font-bold

                text-green-500
                ">
                @Stats.ValorInventario.ToString("N2")
            </h3>

        </div>

    </div>

    <!-- FILTERS -->
    <div class="flex items-center gap-3 flex-wrap">

        <!-- TODOS -->
        <button @onclick="async () =>
                            {
                                SelectedCategory = null;
                                await LoadProducts();
                            }"
                class="
            h-12 px-5 rounded-2xl
            @(SelectedCategory is null
                    ? "bg-primary text-white"
                    : "bg-surface dark:bg-darkSurface border border-borderColor dark:border-darkBorder")
            ">

            Todos

        </button>

        @foreach (var category in Categories)
        {
            <button @onclick="async () =>
                                    {
                                        SelectedCategory = category.Nombre;
                                        await LoadProducts();
                                    }"
                    class="
                h-12 px-5 rounded-2xl transition-all

                @(SelectedCategory == category.Nombre
                        ? "bg-primary text-white"
                        : "bg-surface dark:bg-darkSurface border border-borderColor dark:border-darkBorder")
                ">

                @category.Nombre

            </button>
        }

    </div>
    <!-- PRODUCTS GRID -->
    <div class="
        grid
        grid-cols-1
        md:grid-cols-2
        xl:grid-cols-3

        gap-6
        ">

        @foreach (var product in Products)
        {
            <a href="/inventario/@product.Id"
               class="
                block

                group

                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[32px]

                overflow-hidden

                shadow-soft

                hover:-translate-y-1
                hover:shadow-xl

                transition-all
            ">

                <!-- IMAGE -->
                <div class="
                    h-52
                    overflow-hidden
                    bg-surfaceSoft
                    dark:bg-darkSurfaceSoft
                    ">

                    @if (!string.IsNullOrWhiteSpace(product.Foto))
                    {
                        <img src="@product.Foto"
                             class="
                        w-full
                        h-full
                        object-cover
                        transition-transform
                        duration-300
                        group-hover:scale-105
                        " />
                    }
                    else
                    {
                        <div class="
                            w-full
                            h-full
                            flex
                            items-center
                            justify-center
                            text-6xl
                            ">
                            📦
                        </div>
                    }

                </div>

                <!-- CONTENT -->
                <div class="p-6">

                    <!-- TOP -->
                    <div class="
                        flex
                        items-start
                        justify-between
                        gap-4
                        ">

                        <div>

                            <h3 class="
                                text-xl
                                font-bold

                                text-textPrimary
                                dark:text-darkTextPrimary
                                ">
                                @product.Nombre
                            </h3>
                            <!--Aqui va categoria-->
                            <p class="
                                mt-1

                                text-sm

                                text-textMuted
                                dark:text-darkTextMuted
                                ">

                                @(Categories.FirstOrDefault(
                                    x => x.Id == product.CategoriaId
                                )?.Nombre ?? "Sin categoría")

                            </p>

                        </div>

                        <!-- MENU -->
                        <button class="
                            w-10 h-10

                            rounded-xl

                            hover:bg-surfaceSoft
                            dark:hover:bg-darkSurfaceSoft

                            opacity-0
                            group-hover:opacity-100

                            transition-all
                            ">

                            ⋮

                        </button>

                    </div>

                    <!-- PRICE -->
                    <div class="mt-6">

                        <p class="
                            text-3xl
                            font-bold

                            text-textPrimary
                            dark:text-darkTextPrimary
                            ">
                            $@product.PrecioVenta
                        </p>

                    </div>

                    <!-- STOCK -->
                    <div class="
                        mt-6

                        flex
                        items-center
                        justify-between
                        ">

                        <div>

                            <p class="
                                text-sm

                                text-textMuted
                                dark:text-darkTextMuted
                                ">
                                Stock
                            </p>

                            <p class="
                                mt-1

                                font-semibold

                                text-textPrimary
                                dark:text-darkTextPrimary
                                ">
                                @product.Stock
                            </p>

                        </div>

                        <!-- BADGE -->
                        <div class="
                            px-4 py-2

                            rounded-xl

                            text-sm
                            font-semibold

                            @(product.Stock < 10
                                 ? "bg-orange-50 text-orange-600 dark:bg-orange-500/10 dark:text-orange-400"
                                 : "bg-green-50 text-green-600 dark:bg-green-500/10 dark:text-green-400")
                            ">

                            @(product.Stock < 10 ? "Stock bajo" : "Disponible")

                        </div>

                    </div>

                </div>

            </a>
        }
        <!-- PAGINATION -->
        <div class="
            flex
            items-center
            justify-between

            mt-8
            ">

            <button @onclick="PreviousPage"
                    disabled="@(CurrentPage == 1)"
                    class="
                px-5 py-3

                rounded-2xl

                border border-borderColor
                dark:border-darkBorder

                disabled:opacity-50
                ">

                ← Anterior

            </button>

            <p class="
                text-textMuted
                dark:text-darkTextMuted
                ">

                Página @CurrentPage de @TotalPages

            </p>

            <button @onclick="NextPage"
                    disabled="@(CurrentPage >= TotalPages)"
                    class="
                px-5 py-3

                rounded-2xl

                bg-primary

                text-white

                disabled:opacity-50
                ">

                Siguiente →

            </button>

        </div>

    </div>

</div>
<ProductDrawer Open="OpenProductDrawer"
               OpenChanged="@(value => OpenProductDrawer = value)"
               Categories="Categories"
               OnSaved="LoadProducts" />

@code {

    private string Search = "";

    private string? SelectedCategory;

    private bool OpenProductDrawer;

    private bool Loading = true;

    private List<ProductDto> Products = [];

    private List<CategoryDto> Categories = [];

    private int CurrentPage = 1;

    private int TotalPages;
    private InventarioStatsDto Stats = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
        await LoadProducts();
        Categories =
    await CategoryService.ObtenerCategorias();
    }

    private async Task LoadProducts()
    {
        Loading = true;

        var response =
            await ProductService.ObtenerProductos(
                CurrentPage,
                10,
                Search,
                SelectedCategory);

        if (response is not null)
        {
            Products = response.Data;

            TotalPages = response.TotalPages;
        }

        await LoadStats();

        Loading = false;
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        CurrentPage++;

        await LoadProducts();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        CurrentPage--;

        await LoadProducts();
    }
    private async Task LoadStats()
    {
        Stats =
            await ProductService.ObtenerStats()
            ?? new();
    }

}