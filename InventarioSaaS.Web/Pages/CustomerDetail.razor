@page "/clientes/{Id:int}"
@attribute [Authorize]
@layout DashboardLayout

@using InventarioSaaS.Web.Components.Customers
@using InventarioSaaS.Web.Models.Customers
@using InventarioSaaS.Web.Models.Sales
@using InventarioSaaS.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager

@inject CustomerService CustomerService

@if (Loading)
{
    <div class="
        bg-surface
        dark:bg-darkSurface
        rounded-[32px]
        p-10
        text-center">

        Cargando cliente...

    </div>
}
else if (Customer is null)
{
    <div class="
        bg-surface
        dark:bg-darkSurface
        rounded-[32px]
        p-10
        text-center">

        Cliente no encontrado.

    </div>
}
else
{
    <div class="space-y-8">

        <!-- HEADER -->
        <div class="
            flex
            flex-col
            lg:flex-row
            lg:items-center
            lg:justify-between
            gap-6">

            <div class="flex items-center gap-5">

                <!-- AVATAR -->
                <div class="
                    w-20 h-20
                    rounded-3xl

                    bg-gradient-to-br
                    from-primary
                    to-indigo-500

                    flex
                    items-center
                    justify-center

                    text-white
                    text-3xl
                    font-black">

                    @(Customer.Nombre?.Substring(0, 1).ToUpper())

                </div>

                <div>

                    <p class="
                        text-textMuted
                        dark:text-darkTextMuted">

                        Cliente

                    </p>

                    <h1 class="
                        text-5xl
                        font-black

                        text-textPrimary
                        dark:text-darkTextPrimary">

                        @Customer.Nombre

                    </h1>

                </div>

            </div>

        </div>
        <AuthorizeView Policy="admin">
        <div>

            <button @onclick="OpenEdit"
                    class="
                h-12 px-5
                rounded-2xl
                bg-primary
                text-white
                font-semibold">

                Editar cliente

            </button>

            <button @onclick="() => ShowDeleteModal = true"
                    class="
                h-12 px-5
                rounded-2xl
                bg-red-500
                hover:bg-red-600
                text-white
                font-semibold
                transition-all">

                Eliminar cliente

            </button>

        </div>
        </AuthorizeView>

        <!-- STATS -->
        <div class="
            grid
            grid-cols-1
            md:grid-cols-3
            gap-6">

            <!-- TELEFONO -->
            <div class="
                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[28px]
                p-6">

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    Teléfono

                </p>

                <h3 class="
                    mt-3
                    text-2xl
                    font-bold
                    text-textPrimary
                    dark:text-darkTextPrimary">

                    @(string.IsNullOrWhiteSpace(Customer.NumeroTelefono)
                        ? "No disponible"
                        : Customer.NumeroTelefono)

                </h3>

            </div>

            <!-- DIRECCION -->
            <div class="
                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[28px]
                p-6">

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    Dirección

                </p>

                <h3 class="
                    mt-3
                    text-2xl
                    font-bold
                    text-textPrimary
                    dark:text-darkTextPrimary">

                    @(string.IsNullOrWhiteSpace(Customer.Direccion)
                        ? "No disponible"
                        : Customer.Direccion)

                </h3>

            </div>

            <!-- FACTURAS -->
            <div class="
                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[28px]
                p-6">

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    Facturas

                </p>

                <h3 class="
                    mt-3
                    text-4xl
                    font-black
                    text-primary">

                    @Customer.Facturas.Count

                </h3>

            </div>

        </div>

        <!-- FACTURAS -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[32px]

            overflow-hidden">

            <!-- HEADER -->
            <div class="
                grid
                grid-cols-4

                px-8 py-5

                border-b
                border-borderColor
                dark:border-darkBorder

                text-sm
                font-semibold

                text-textMuted
                dark:text-darkTextMuted">

                <div>Factura</div>
                <div>Fecha</div>
                <div>Total</div>
                <div>Estado</div>

            </div>

            <!-- ROWS -->
            @if (Customer.Facturas.Count == 0)
            {
                <div class="
                    p-12
                    text-center">

                    <div class="text-6xl">
                        🧾
                    </div>

                    <h3 class="
                        mt-5
                        text-2xl
                        font-bold
                        text-textPrimary
                        dark:text-darkTextPrimary">

                        Sin facturas

                    </h3>

                    <p class="
                        mt-2
                        text-textMuted
                        dark:text-darkTextMuted">

                        Este cliente todavía no tiene facturas.

                    </p>

                </div>
            }
            else
            {
                @foreach (var factura in Customer.Facturas)
                {
                    <a href="/facturas/@factura.Id"
                       class="
                        grid
                        grid-cols-4

                        px-8 py-5

                        items-center

                        hover:bg-surfaceSoft
                        dark:hover:bg-darkSurfaceSoft

                        transition-all">

                        <div class="
                            font-semibold
                            text-textPrimary
                            dark:text-darkTextPrimary">

                            #@factura.Id

                        </div>

                        <div class="
                            text-textMuted
                            dark:text-darkTextMuted">

                            @factura.Fecha.ToString("dd/MM/yyyy")

                        </div>

                        <div class="
                            font-bold
                            text-textPrimary
                            dark:text-darkTextPrimary">

                            $@factura.Total

                        </div>

                        <div>

                            <span class="
                                px-4 py-2
                                rounded-xl

                                bg-primary/10
                                text-primary

                                text-sm
                                font-semibold">

                                @factura.TipoPago

                            </span>

                        </div>

                    </a>
                }
            }

        </div>

    </div>
}
@if (ShowDeleteModal)
{
    <!-- OVERLAY -->
    <div class="
        fixed inset-0
        z-40
        bg-black/50
        backdrop-blur-sm"
         @onclick="CloseDeleteModal">
    </div>

    <!-- MODAL -->
    <div class="
        fixed inset-0
        z-50
        flex items-center justify-center
        p-6">

        <div class="
            w-full max-w-md
            rounded-[32px]
            bg-surface
            dark:bg-darkSurface
            border
            border-borderColor
            dark:border-darkBorder
            p-8
            shadow-2xl">

            <!-- ICON -->
            <div class="
                w-20 h-20
                mx-auto
                rounded-full
                bg-red-500/10
                flex items-center justify-center
                text-4xl">

                🗑️

            </div>

            <!-- TITLE -->
            <h2 class="
                mt-6
                text-3xl
                font-bold
                text-center
                text-textPrimary
                dark:text-darkTextPrimary">

                Eliminar cliente

            </h2>

            <!-- DESCRIPTION -->
            <p class="
                mt-4
                text-center
                text-textMuted
                dark:text-darkTextMuted">

                Esta acción eliminará permanentemente el cliente
                <span class="font-semibold">
                    @Customer?.Nombre
                </span>.

                <br /><br />

                ¿Deseas continuar?

            </p>

            <!-- ACTIONS -->
            <div class="
                mt-8
                flex items-center justify-end gap-4">

                <button @onclick="CloseDeleteModal"
                        class="
                    h-14 px-6
                    rounded-2xl
                    bg-surfaceSoft
                    dark:bg-darkSurfaceSoft
                    font-semibold">

                    Cancelar

                </button>

                <button @onclick="DeleteCustomer"
                        class="
                    h-14 px-6
                    rounded-2xl
                    bg-red-500
                    hover:bg-red-600
                    text-white
                    font-semibold
                    transition-all">

                    Sí, eliminar

                </button>

            </div>

        </div>

    </div>
}
<EditCustomerDrawer Open="OpenEditDrawer"
                    OpenChanged="@(value => OpenEditDrawer = value)"
                    Model="EditModel"
                    OnSaved="ReloadCustomer" />

@code {

    [Parameter]
    public int Id { get; set; }

    private bool Loading = true;

    private LeerClienteDto? Customer;
    private bool OpenEditDrawer;

    private UpdateCustomerDto EditModel = new();
    private bool ShowDeleteModal;

    protected override async Task OnInitializedAsync()
    {
        Customer =
            await CustomerService.ObtenerClientePorId(Id);

        Loading = false;
    }
    private void OpenEdit()
    {
        EditModel = new UpdateCustomerDto
        {
            Id = Customer.Id,
            Nombre = Customer.Nombre,
            NumeroTelefono = Customer.NumeroTelefono,
            Direccion = Customer.Direccion
        };

        OpenEditDrawer = true;
    }
    private async Task ReloadCustomer()
    {
        Customer =
            await CustomerService
                .ObtenerClientePorId(Id);
    }
    private async Task DeleteCustomer()
    {
        var success =
            await CustomerService
                .EliminarCliente(Customer.Id);

        if (success)
        {
            NavManager.NavigateTo("/clientes");
        }
    }
    private void CloseDeleteModal()
    {
        ShowDeleteModal = false;
    }

}