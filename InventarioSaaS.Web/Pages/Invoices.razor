@page "/facturas"
@attribute [Authorize]
@layout DashboardLayout
@using Microsoft.AspNetCore.Authorization
@using InventarioSaaS.Web.Components.Invoices
@using InventarioSaaS.Web.Models.Sales
@using InventarioSaaS.Web.Services
@using InventarioSaaS.Web.Components
@using InventarioSaaS.Web.Models.Products
@using InventarioSaaS.Web.Models.Customers

@inject SalesService SalesService
@inject ProductService ProductService
@inject CustomerService CustomerService

<div class="space-y-8">

    <!-- HEADER -->
    <div class="flex items-center justify-between">

        <div>

            <h1 class="
                text-4xl
                font-bold
                text-textPrimary
                dark:text-darkTextPrimary">

                Facturas

            </h1>

            <p class="
                mt-2
                text-textMuted
                dark:text-darkTextMuted">

                Gestiona todas las facturas de tu empresa.

            </p>

        </div>
        <button @onclick="() => OpenDrawer = true"
                class="
            px-6 py-4
            rounded-2xl
            bg-primary
            hover:bg-primary-dark
            text-white
            font-semibold
            transition-all
            hover:scale-105
            shadow-glow">

            Nueva factura

        </button>

    </div>

    <!-- FILTERS -->
    <div class="
        flex
        flex-col
        lg:flex-row
        lg:items-center
        lg:justify-between
        gap-4">

        <!-- SEARCH -->
        <div class="
            flex items-center gap-3
            h-14
            w-full
            lg:w-[340px]
            px-5
            rounded-2xl
            bg-surface
            dark:bg-darkSurface
            border
            border-borderColor
            dark:border-darkBorder">

            🔍

            <input value="@Search"
                   @oninput="SearchChanged"
                   placeholder="Buscar factura..."
                   class="
            bg-transparent
            outline-none
            flex-1
            text-textPrimary
            dark:text-darkTextPrimary" />

        </div>

        <!-- FILTERS -->
        <div class="flex items-center gap-3">

            <button class="
                h-14 px-5
                rounded-2xl
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder
                text-sm
                font-medium
                text-textMuted
                dark:text-darkTextMuted">

                Este mes

            </button>

            <button class="
                h-14 px-5
                rounded-2xl
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder
                text-sm
                font-medium
                text-textMuted
                dark:text-darkTextMuted">

                Exportar

            </button>

        </div>

    </div>

    @if (Loading)
    {
        <div class="
            bg-surface
            dark:bg-darkSurface
            rounded-[32px]
            p-10
            text-center
            text-textMuted
            dark:text-darkTextMuted">

            Cargando facturas...

        </div>
    }
    else
    {
        <!-- TABLE -->
        <div class="
            overflow-hidden
            bg-surface
            dark:bg-darkSurface
            border
            border-borderColor
            dark:border-darkBorder
            rounded-[32px]
            shadow-soft">

            <!-- TABLE HEADER -->
            <div class="
                grid
                grid-cols-[1fr_1fr_1.5fr_1fr_1fr_1fr_80px]
                gap-4
                px-8 py-5
                border-b
                border-borderColor
                dark:border-darkBorder
                text-sm
                font-semibold
                text-textMuted
                dark:text-darkTextMuted">

                <div>Factura</div>
                <div>Cliente</div>
                <div>Vendedor</div>
                <div>Fecha</div>
                <div>Total</div>
                <div>Estado</div>
                <div></div>

            </div>

            <!-- ROWS -->
            @if (Invoice.Count == 0)
            {
                <div class="
                    p-16
                    text-center">

                    <div class="text-6xl">
                        🧾
                    </div>

                    <h3 class="
                        mt-6
                        text-2xl
                        font-bold
                        text-textPrimary
                        dark:text-darkTextPrimary">

                        No hay facturas

                    </h3>

                    <p class="
                        mt-3
                        text-textMuted
                        dark:text-darkTextMuted">

                        Las ventas aparecerán aquí.

                    </p>

                </div>
            }
            else
            {
                @foreach (var invoice in Invoice)
                {
                    <a href="/facturas/@invoice.Id"
                       class="
                        grid
                        grid-cols-[1fr_1fr_1.5fr_1fr_1fr_1fr_80px]
                        gap-4
                        items-center
                        px-8 py-5
                        border-b
                        border-borderColor
                        dark:border-darkBorder

                        hover:bg-surfaceSoft
                        dark:hover:bg-darkSurfaceSoft

                        transition-all
                        cursor-pointer">

                        <!-- INVOICE -->
                        <div>

                            <p class="
                                font-semibold
                                text-textPrimary
                                dark:text-darkTextPrimary">

                                #@invoice.Id

                            </p>

                        </div>

                        <!-- CLIENT -->
                        <div class="flex items-center gap-3">

                            <div class="
                                w-10 h-10
                                rounded-xl
                                bg-primary/10
                                flex items-center justify-center
                                text-primary
                                font-bold">

                                @(invoice.NombreCliente)

                            </div>

                        </div>

                        <!-- USER -->
                        <div>

                            <p class="
                                truncate
                                font-semibold
                                text-textPrimary
                                dark:text-darkTextPrimary">

                                @invoice.NombreVendedor

                            </p>

                        </div>

                        <!-- DATE -->
                        <div class="
                            text-textMuted
                            dark:text-darkTextMuted">

                            @invoice.Fecha.ToString("dd/MM/yyyy")

                        </div>

                        <!-- TOTAL -->
                        <div>

                            <p class="
                                font-semibold
                                text-green-500">

                                $@invoice.Total

                            </p>

                        </div>

                        <!-- STATUS -->
                        <div>

                            <StatusBadge Text="@invoice.TipoPago.ToString()" />

                        </div>

                        <!-- ACTION -->
                        <div class="flex justify-end">
                            <button @onclick="() => DescargarPdf(invoice.Id)">
                                PDF
                            </button>

                        </div>

                    </a>
                }
            }

        </div>

        <!-- PAGINATION -->
        <div class="
            flex
            items-center
            justify-between">

            <!-- PREVIOUS -->
            <button @onclick="PreviousPage"
                    disabled="@(CurrentPage == 1)"
                    class="
                px-5 py-3
                rounded-2xl
                border border-borderColor
                bg-surface
                dark:bg-darkSurface
                disabled:opacity-50
                disabled:cursor-not-allowed
                hover:bg-surfaceSoft
                dark:hover:bg-darkSurfaceSoft
                transition-all">

                ← Anterior

            </button>

            <!-- PAGE INFO -->
            <div class="
                flex
                items-center
                gap-3">

                <div class="
                    w-10 h-10
                    rounded-xl
                    bg-primary
                    text-white
                    font-semibold
                    flex
                    items-center
                    justify-center">

                    @CurrentPage

                </div>

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    de @TotalPages

                </p>

            </div>

            <!-- NEXT -->
            <button @onclick="NextPage"
                    disabled="@(CurrentPage >= TotalPages)"
                    class="
                px-5 py-3
                rounded-2xl
                bg-primary
                text-white
                disabled:opacity-50
                disabled:cursor-not-allowed
                hover:scale-[1.02]
                transition-all">

                Siguiente →

            </button>

        </div>
    }

</div>
<SaleDrawer
    Open="OpenDrawer"
    OpenChanged="@(value => OpenDrawer = value)"
    OnSaved="LoadInvoices" />

@code {

    private bool Loading = true;

    private string Search = "";

    private List<SaleDto> Invoice = [];

    private int CurrentPage = 1;

    private int TotalPages;

    private bool OpenDrawer;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();

    }
    private async Task DescargarPdf(int id)
    {
        await SalesService.DescargarFactura(id);
    }

    private async Task LoadInvoices()
    {
        Loading = true;

        var response =
            await SalesService.ObtenerVentas(
                CurrentPage,
                Search);

        if (response is not null)
        {
            Invoice = response.Data;

            TotalPages = response.TotalPages;
        }

        Loading = false;
    }

    private async Task SearchChanged(ChangeEventArgs e)
    {
        Search = e.Value?.ToString() ?? "";

        CurrentPage = 1;

        await LoadInvoices();
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        CurrentPage++;

        await LoadInvoices();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        CurrentPage--;

        await LoadInvoices();
    }

}