@page "/cuentas-por-cobrar"
@attribute [Authorize]
@layout DashboardLayout

@using InventarioSaaS.Web.Models.AccountsReceivable
@using InventarioSaaS.Web.Services
@using InventarioSaaS.Web.Components
@using Microsoft.AspNetCore.Authorization

@inject AccountsReceivableService Service

<div class="space-y-8">

    <!-- HEADER -->
    <div class="flex items-center justify-between">

        <div>

            <h1 class="
                text-4xl
                font-bold
                text-textPrimary
                dark:text-darkTextPrimary">

                Cuentas por cobrar

            </h1>

            <p class="
                mt-2
                text-textMuted
                dark:text-darkTextMuted">

                Gestiona las ventas pendientes y pagos a crédito.

            </p>

        </div>

    </div>

    <!-- FILTERS -->
    <div class="
        flex
        flex-col
        lg:flex-row
        lg:items-center
        lg:justify-between
        gap-4">

        <!-- SEARCH -->
        <div class="
            flex items-center gap-3
            h-14
            w-full
            lg:w-[340px]
            px-5
            rounded-2xl
            bg-surface
            dark:bg-darkSurface
            border
            border-borderColor
            dark:border-darkBorder">

            🔍

            <input value="@Search"
                   @oninput="SearchChanged"
                   placeholder="Buscar factura..."
                   class="
            bg-transparent
            outline-none
            flex-1
            text-textPrimary
            dark:text-darkTextPrimary" />

        </div>

        <!-- ACTIONS -->
        <div class="flex items-center gap-3">

            <button class="
                h-14 px-5
                rounded-2xl
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder
                text-sm
                font-medium
                text-textMuted
                dark:text-darkTextMuted">

                Pendientes

            </button>

            <button class="
                h-14 px-5
                rounded-2xl
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder
                text-sm
                font-medium
                text-textMuted
                dark:text-darkTextMuted">

                Exportar

            </button>

        </div>

    </div>

    @if (Loading)
    {
        <div class="
            bg-surface
            dark:bg-darkSurface
            rounded-[32px]
            p-10
            text-center
            text-textMuted
            dark:text-darkTextMuted">

            Cargando cuentas...

        </div>
    }
    else
    {
        <!-- TABLE -->
        <div class="
            overflow-hidden
            bg-surface
            dark:bg-darkSurface
            border
            border-borderColor
            dark:border-darkBorder
            rounded-[32px]
            shadow-soft">

            <!-- TABLE HEADER -->
            <div class="
                grid
                grid-cols-[120px_1fr_1fr_180px_180px_160px_120px]
                gap-4
                px-8 py-5
                border-b
                border-borderColor
                dark:border-darkBorder
                text-sm
                font-semibold
                text-textMuted
                dark:text-darkTextMuted">

                <div>ID</div>
                <div>Factura</div>
                <div>Total</div>
                <div>Pendiente</div>
                <div>Estado</div>
                <div></div>
                <div></div>

            </div>

            <!-- ROWS -->
            @if (Accounts.Count == 0)
            {
                <div class="
                    p-16
                    text-center">

                    <div class="text-6xl">
                        💳
                    </div>

                    <h3 class="
                        mt-6
                        text-2xl
                        font-bold
                        text-textPrimary
                        dark:text-darkTextPrimary">

                        No hay cuentas pendientes

                    </h3>

                    <p class="
                        mt-3
                        text-textMuted
                        dark:text-darkTextMuted">

                        Las ventas a crédito aparecerán aquí.

                    </p>

                </div>
            }
            else
            {
                @foreach (var cuenta in Accounts)
                {
                    <a href="/cuentas-por-cobrar/@cuenta.Id"
                       class="
                        grid
                        grid-cols-[1fr_1fr_1fr_1fr_1fr_80px]
                        gap-4
                        items-center
                        px-8 py-5
                        border-b
                        border-borderColor
                        dark:border-darkBorder

                        hover:bg-surfaceSoft
                        dark:hover:bg-darkSurfaceSoft

                        transition-all
                        cursor-pointer">

                        <!-- ID -->
                        <div class="
                            font-semibold
                            text-textPrimary
                            dark:text-darkTextPrimary">

                            #@cuenta.Id

                        </div>

                        <!-- FACTURA -->
                        <div class="
                            text-textMuted
                            dark:text-darkTextMuted">

                            Factura #@cuenta.VentaID

                        </div>

                        <!-- TOTAL -->
                        <div class="font-semibold">
                            @cuenta.MontoTotal.ToString("C")
                        </div>

                        <!-- PENDIENTE -->
                        <div class="text-red-500 font-semibold">
                            @cuenta.MontoPendiente.ToString("C")
                        </div>

                        <!-- ESTADO -->
                        <div>
                            <StatusBadge Text="@cuenta.Estado.ToString()" />
                        </div>

                        <!-- ACTION -->
                        <div class="text-right">
                            →
                        </div>

                    </a>
                }
            }

        </div>

        <!-- PAGINATION -->
        <div class="
            flex
            items-center
            justify-between">

            <!-- PREVIOUS -->
            <button @onclick="PreviousPage"
                    disabled="@(CurrentPage == 1)"
                    class="
                px-5 py-3
                rounded-2xl
                border border-borderColor
                bg-surface
                dark:bg-darkSurface
                disabled:opacity-50
                disabled:cursor-not-allowed
                hover:bg-surfaceSoft
                dark:hover:bg-darkSurfaceSoft
                transition-all">

                ← Anterior

            </button>

            <!-- PAGE -->
            <div class="
                flex
                items-center
                gap-3">

                <div class="
                    w-10 h-10
                    rounded-xl
                    bg-primary
                    text-white
                    font-semibold
                    flex
                    items-center
                    justify-center">

                    @CurrentPage

                </div>

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    de @TotalPages

                </p>

            </div>

            <!-- NEXT -->
            <button @onclick="NextPage"
                    disabled="@(CurrentPage >= TotalPages)"
                    class="
                px-5 py-3
                rounded-2xl
                bg-primary
                text-white
                disabled:opacity-50
                disabled:cursor-not-allowed
                hover:scale-[1.02]
                transition-all">

                Siguiente →

            </button>

        </div>
    }

</div>

@code {

    private List<LeerCuentasPorCobrarReportes>
        Accounts = [];

    private bool Loading;

    private int CurrentPage = 1;

    private int TotalPages = 1;

    private string Search = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        try
        {
            Loading = true;

            var response =
                await Service.Obtener(
                    CurrentPage,
                    Search);

            if (response is not null)
            {
                Accounts = response.Data;

                TotalPages =
                    response.TotalPages;
            }
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task SearchChanged(
        ChangeEventArgs e)
    {
        Search =
            e.Value?.ToString() ?? "";

        CurrentPage = 1;

        await LoadAccounts();
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        CurrentPage++;

        await LoadAccounts();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        CurrentPage--;

        await LoadAccounts();
    }

}