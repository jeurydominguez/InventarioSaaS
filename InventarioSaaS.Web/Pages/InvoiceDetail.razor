@page "/facturas/{Id:int}"
@attribute [Authorize]
@layout DashboardLayout

@using InventarioSaaS.Web.Models.Sales
@using InventarioSaaS.Web.Services
@using Microsoft.AspNetCore.Authorization

@inject SalesService SalesService

@if (Loading)
{
    <div class="
        bg-surface
        dark:bg-darkSurface
        rounded-[32px]
        p-10
        text-center">

        Cargando factura...

    </div>
}
else if (Invoice is null)
{
    <div class="
        bg-surface
        dark:bg-darkSurface
        rounded-[32px]
        p-10
        text-center">

        Factura no encontrada.

    </div>
}
else
{
    <div class="space-y-8">

        <!-- HEADER -->
        <div class="
            flex
            flex-col
            lg:flex-row
            lg:items-center
            lg:justify-between
            gap-6">

            <div>

                <p class="
                    text-textMuted
                    dark:text-darkTextMuted">

                    Factura

                </p>

                <h1 class="
                    mt-2
                    text-5xl
                    font-black

                    text-textPrimary
                    dark:text-darkTextPrimary">

                    #@Invoice.Id

                </h1>

            </div>

            <div class="
                px-5 py-3
                rounded-2xl

                bg-primary/10
                text-primary

                font-semibold">

                @Invoice.TipoPago

            </div>

        </div>

        <!-- STATS -->
        <div class="
            grid
            grid-cols-1
            md:grid-cols-3
            gap-6">

            <!-- TOTAL -->
            <div class="
                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[28px]
                p-6">

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    Total

                </p>

                <h3 class="
                    mt-3
                    text-4xl
                    font-black
                    text-textPrimary
                    dark:text-darkTextPrimary">

                    $@Invoice.Total

                </h3>

            </div>

            <!-- FECHA -->
            <div class="
                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[28px]
                p-6">

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    Fecha

                </p>

                <h3 class="
                    mt-3
                    text-2xl
                    font-bold
                    text-textPrimary
                    dark:text-darkTextPrimary">

                    @Invoice.Fecha.ToString("dd/MM/yyyy")

                </h3>

            </div>

            <!-- CLIENTE -->
            <div class="
                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder

                rounded-[28px]
                p-6">

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted">

                    Cliente

                </p>

                @if (Invoice.Cliente is not null)
                {
                    <a href="/clientes/@Invoice.Cliente.Id"
                       class="
                        mt-3
                        block

                        text-2xl
                        font-bold

                        text-primary">

                        @Invoice.Cliente.Nombre

                    </a>
                }
                else
                {
                    <h3 class="
                        mt-3
                        text-2xl
                        font-bold
                        text-textPrimary
                        dark:text-darkTextPrimary">

                        Consumidor final

                    </h3>
                }

            </div>

        </div>

        <!-- PRODUCTOS -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[32px]

            overflow-hidden">

            <!-- HEADER -->
            <div class="
                grid
                grid-cols-5

                px-8 py-5

                border-b
                border-borderColor
                dark:border-darkBorder

                text-sm
                font-semibold

                text-textMuted
                dark:text-darkTextMuted">

                <div>Producto</div>
                <div>Cantidad</div>
                <div>Precio</div>
                <div>Subtotal</div>
                <div></div>

            </div>

            <!-- ROWS -->
            @foreach (var item in Invoice.Detalle)
            {
                <a href="/inventario/@item.ProductoId"
                   class="
                    grid
                    grid-cols-5

                    px-8 py-5

                    items-center

                    hover:bg-surfaceSoft
                    dark:hover:bg-darkSurfaceSoft

                    transition-all">

                    <div class="
                        font-semibold
                        text-textPrimary
                        dark:text-darkTextPrimary">

                        @item.Nombre

                    </div>

                    <div class="
                        text-textMuted
                        dark:text-darkTextMuted">

                        @item.Cantidad

                    </div>

                    <div class="
                        text-textPrimary
                        dark:text-darkTextPrimary">

                        $@item.PrecioUnitario

                    </div>

                    <div class="
                        font-bold
                        text-textPrimary
                        dark:text-darkTextPrimary">

                        $@item.SubTotal

                    </div>

                    <div class="
                        text-right
                        text-textMuted">

                        →

                    </div>

                </a>
            }

        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private bool Loading = true;

    private LeerVentaDtoUnidad? Invoice;

    protected override async Task OnInitializedAsync()
    {
        Invoice =
            await SalesService
                .ObtenerVentaPorId(Id);

        Loading = false;
    }
    private async Task DescargarPdf(int id)
    {
        await SalesService.DescargarFactura(id);
    }
}