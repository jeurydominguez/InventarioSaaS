@page "/cuentas-por-cobrar/{Id:int}"
@attribute [Authorize]
@layout DashboardLayout

@using InventarioSaaS.Web.Models.AccountsReceivable
@using InventarioSaaS.Web.Services
@using InventarioSaaS.Web.Components.Payments
@using Microsoft.AspNetCore.Authorization
@inject AccountsReceivableService Service

<div class="space-y-8">

    @if (Loading)
    {
        <div class="
            bg-surface
            dark:bg-darkSurface
            rounded-[32px]
            p-10">

            Cargando cuenta...

        </div>
    }
    else if (Account is not null)
    {
        <!-- HEADER -->
        <div class="flex items-center justify-between">

            <div>

                <h1 class="
                    text-4xl
                    font-bold
                    text-textPrimary
                    dark:text-darkTextPrimary">

                    Cuenta por cobrar #@Account.Id

                </h1>

                <p class="
                    mt-2
                    text-textMuted
                    dark:text-darkTextMuted">

                    Factura #@Account.Venta.Id

                </p>

            </div>

            <StatusBadge Text="@Account.Estado.ToString()" />

        </div>

        <div>
            <button @onclick="() => OpenPaymentDrawer = true"
                    class="
                px-6 py-3
                rounded-2xl
                bg-primary
                text-white
                font-semibold
                hover:scale-105
                transition-all">

                Registrar pago

            </button>
        </div>

        <!-- CARDS -->
        <div class="
            grid
            grid-cols-1
            md:grid-cols-3
            gap-6">

            <!-- TOTAL -->
            <div class="
                p-6
                rounded-[32px]
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder">

                <p class="text-sm opacity-70">
                    Total
                </p>

                <h3 class="text-3xl font-bold mt-3">
                    @Account.MontoTotal.ToString("C")
                </h3>

            </div>

            <!-- PENDIENTE -->
            <div class="
                p-6
                rounded-[32px]
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder">

                <p class="text-sm opacity-70">
                    Pendiente
                </p>

                <h3 class="text-3xl font-bold mt-3 text-red-500">
                    @Account.MontoPendiente.ToString("C")
                </h3>

            </div>

            <!-- CLIENTE -->
            <div class="
                p-6
                rounded-[32px]
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder">

                <p class="text-sm opacity-70">
                    Cliente
                </p>

                <h3 class="text-2xl font-bold mt-3">
                    @Account.Cliente.Nombre
                </h3>

            </div>

        </div>

        <!-- PAGOS -->
        <div class="
            bg-surface
            dark:bg-darkSurface
            rounded-[32px]
            border
            border-borderColor
            dark:border-darkBorder
            overflow-hidden">

            <div class="
                px-8 py-5
                border-b
                border-borderColor
                dark:border-darkBorder">

                <h2 class="text-2xl font-bold">
                    Pagos
                </h2>

            </div>

            @if (Account.Pagos.Count == 0)
            {
                <div class="p-10 text-center opacity-70">
                    No hay pagos registrados.
                </div>
            }
            else
            {
                @foreach (var pago in Account.Pagos)
                {
                    <div class="
                        flex
                        items-center
                        justify-between
                        px-8 py-5
                        border-b
                        border-borderColor
                        dark:border-darkBorder">

                        <div>

                            <p class="font-semibold">
                                Pago #@pago.Id
                            </p>

                            <p class="text-sm opacity-70">
                                @pago.Fecha.ToString("dd/MM/yyyy")
                            </p>

                        </div>

                        <div class="
                            text-green-500
                            font-bold
                            text-xl">

                            @pago.Monto.ToString("C")

                        </div>

                    </div>
                }
            }

        </div>
    }

</div>
@if (Account is not null)
{
    <PaymentDrawer Open="OpenPaymentDrawer"
                   OpenChanged="@(value => OpenPaymentDrawer = value)"
                   CuentaId="@Account.Id"
                   OnSaved="ReloadCuenta" />
}

@code {

    private bool OpenPaymentDrawer;
    [Parameter]
    public int Id { get; set; }

    private bool Loading;

    private AccountReceivableDetailDto? Account;

    protected override async Task OnInitializedAsync()
    {
        Loading = true;

        Account =
            await Service.ObtenerPorId(Id);

        Loading = false;
    }
    private async Task ReloadCuenta()
    {
        Account =
            await Service.ObtenerPorId(Id);
    }
}