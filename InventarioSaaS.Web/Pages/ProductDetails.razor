@page "/inventario/{Id:int}"
@attribute [Authorize]
@using InventarioSaaS.Web.Models.Products
@using InventarioSaaS.Web.Services
@using InventarioSaaS.Web.Models.Categories
@using InventarioSaaS.Web.Components.Inventory
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject CategoryService CategoryService
@inject ProductService ProductService
@inject NavigationManager NavManager

@layout DashboardLayout

@if (Loading)
{
    <p>Cargando...</p>
}
else if (Product is null)
{
    <p>Producto no encontrado.</p>
}
else
{
    <div class="space-y-8">

        <!-- HEADER -->
        <div class="
            flex
            items-center
            justify-between
            ">

            <div>

                <p class="
                    text-sm
                    text-textMuted
                    dark:text-darkTextMuted
                    ">
                    Producto
                </p>

                <h1 class="
                    mt-2
                    text-5xl
                    font-black
                    text-textPrimary
                    dark:text-darkTextPrimary
                    ">
                    @Product.Nombre
                </h1>

            </div>

        </div>
        <AuthorizeView Policy="admin">
        <button @onclick="OpenEdit"
                class="
            h-12
            px-5
            rounded-2xl
            bg-primary
            text-white
            font-semibold
            ">

            Editar producto

        </button>

        <button @onclick="() => ShowDeleteModal = true"
                class="
            h-12
            px-5

            rounded-2xl

            bg-red-500
            hover:bg-red-600

            text-white
            font-semibold

            transition-all">

            Eliminar producto

        </button>
        </AuthorizeView>

        <!-- GRID -->
        <div class="
            grid
            grid-cols-1
            xl:grid-cols-3
            gap-6
            ">

            <!-- LEFT -->
            <div class="
                xl:col-span-2
                bg-surface
                dark:bg-darkSurface
                border
                border-borderColor
                dark:border-darkBorder
                rounded-[32px]
                p-8
                ">

                <!-- IMAGE -->
                @if (!string.IsNullOrWhiteSpace(Product.Foto))
                {
                    <div class="
                        w-full
                        h-[320px]

                        rounded-3xl
                        overflow-hidden

                        bg-surfaceSoft
                        dark:bg-darkSurfaceSoft

                        flex items-center justify-center
                    ">

                        <img src="@Product.Foto"
                             class="
                                max-w-full
                                max-h-full
                                object-contain
                             " />
                    </div>                    
                }
                else
                {
                    <div class="
                        w-full
                        h-[320px]

                        rounded-3xl

                        bg-surfaceSoft
                        dark:bg-darkSurfaceSoft

                        flex
                        items-center
                        justify-center

                        text-7xl
                        ">
                        📦
                    </div>
                }

                <!-- INFO -->
                <div class="mt-8 space-y-6">

                    <!-- NOMBRE -->
                    <div>

                        <p class="
                            text-sm
                            text-textMuted
                            dark:text-darkTextMuted
                            ">
                            Nombre
                        </p>

                        <h2 class="
                            mt-2
                            text-3xl
                            font-bold
                            text-textPrimary
                            dark:text-darkTextPrimary
                            ">
                            @Product.Nombre
                        </h2>

                    </div>

                    <!-- CATEGORIA -->
                    <div>

                        <p class="
                            text-sm
                            text-textMuted
                            dark:text-darkTextMuted
                            ">
                            Categoría
                        </p>

                        <h2 class="
                            mt-2
                            text-xl
                            font-semibold
                            text-textPrimary
                            dark:text-darkTextPrimary
                            ">
                            @Product.Categoria?.Nombre
                        </h2>

                    </div>

                    <!-- DESCRIPCION -->
                    <div>

                        <p class="
                            text-sm
                            text-textMuted
                            dark:text-darkTextMuted
                            ">
                            Descripción
                        </p>

                        <p class="
                            mt-2
                            text-base
                            leading-relaxed
                            text-textPrimary
                            dark:text-darkTextPrimary
                            ">
                            @Product.Descripcion
                        </p>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="space-y-6">

                <!-- PRICE -->
                <div class="
                    bg-surface
                    dark:bg-darkSurface
                    border
                    border-borderColor
                    dark:border-darkBorder
                    rounded-[32px]
                    p-8
                    ">

                    <p class="
                        text-sm
                        text-textMuted
                        dark:text-darkTextMuted
                        ">
                        Precio
                    </p>

                    <h2 class="
                        mt-3
                        text-5xl
                        font-black
                        text-textPrimary
                        dark:text-darkTextPrimary
                        ">
                        $@Product.PrecioVenta
                    </h2>

                </div>
                <AuthorizeView Policy="admin">
                <div class="
                    bg-surface
                    dark:bg-darkSurface
                    border
                    border-borderColor
                    dark:border-darkBorder
                    rounded-[32px]
                    p-8
                    ">

                    <p class="
                        text-sm
                        text-textMuted
                        dark:text-darkTextMuted
                        ">
                        Precio Compra
                    </p>

                    <h2 class="
                        mt-3
                        text-5xl
                        font-black
                        text-textPrimary
                        dark:text-darkTextPrimary
                        ">
                        $@Product.PrecioCompra
                    </h2>

                </div>
                </AuthorizeView>

                <!-- STOCK -->
                <div class="
                    bg-surface
                    dark:bg-darkSurface
                    border
                    border-borderColor
                    dark:border-darkBorder
                    rounded-[32px]
                    p-8
                    ">

                    <p class="
                        text-sm
                        text-textMuted
                        dark:text-darkTextMuted
                        ">
                        Stock disponible
                    </p>

                    <h2 class="
                        mt-3
                        text-5xl
                        font-black
                        @(Product.Stock < 10
                            ? "text-orange-500"
                            : "text-green-500")
                        ">
                        @Product.Stock
                    </h2>

                </div>

            </div>

        </div>

    </div>
}
@if (ShowDeleteModal)
{
    <!-- OVERLAY -->
    <div class="
        fixed inset-0
        z-40
        bg-black/50
        backdrop-blur-sm"
         @onclick="CloseDeleteModal">
    </div>

    <!-- MODAL -->
    <div class="
        fixed inset-0
        z-50
        flex items-center justify-center
        p-6">

        <div class="
            w-full max-w-md

            rounded-[32px]

            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            p-8

            shadow-2xl">

            <!-- ICON -->
            <div class="
                w-20 h-20
                mx-auto

                rounded-full

                bg-red-500/10

                flex items-center justify-center

                text-4xl">

                🗑️

            </div>

            <!-- TITLE -->
            <h2 class="
                mt-6

                text-3xl
                font-bold

                text-center

                text-textPrimary
                dark:text-darkTextPrimary">

                Eliminar producto

            </h2>

            <!-- DESCRIPTION -->
            <p class="
                mt-4

                text-center

                text-textMuted
                dark:text-darkTextMuted">

                Esta acción eliminará permanentemente el producto

                <span class="font-semibold">
                    @Product?.Nombre
                </span>.

                <br /><br />

                ¿Deseas continuar?

            </p>

            <!-- ACTIONS -->
            <div class="
                mt-8

                flex items-center justify-end gap-4">

                <button @onclick="CloseDeleteModal"
                        class="
                    h-14
                    px-6

                    rounded-2xl

                    bg-surfaceSoft
                    dark:bg-darkSurfaceSoft

                    font-semibold">

                    Cancelar

                </button>

                <button @onclick="DeleteProduct"
                        class="
                    h-14
                    px-6

                    rounded-2xl

                    bg-red-500
                    hover:bg-red-600

                    text-white
                    font-semibold

                    transition-all">

                    Sí, eliminar

                </button>

            </div>

        </div>

    </div>
}

<EditProductDrawer Open="OpenEditDrawer"
                   OpenChanged="@(value => OpenEditDrawer = value)"
                   Model="EditModel"
                   Categories="Categories"
                   OnSaved="ReloadProduct" />

@code {

    [Parameter]
    public int Id { get; set; }

    private bool Loading = true;

    private bool OpenEditDrawer;

    private ProductDetailDto? Product;

    private EditProductDto EditModel = new();

    private List<CategoryDto> Categories = [];
    private bool ShowDeleteModal;

    protected override async Task OnInitializedAsync()
    {
        Product =
            await ProductService
                .ObtenerProductoPorId(Id);

        Categories =
            await CategoryService
                .ObtenerCategorias();

        Loading = false;
    }

    private void OpenEdit()
    {
        if (Product is null)
            return;

        EditModel = new EditProductDto
        {
            Id = Product.Id,
            Nombre = Product.Nombre,
            PrecioVenta = Product.PrecioVenta,
            PrecioCompra = Product.PrecioCompra,
            Stock = Product.Stock,
            CategoriaId = Product.CategoriaId,
            EmpresaId = Product.EmpresaId,
            Foto = Product.Foto,
            Descripcion = Product.Descripcion
        };

        OpenEditDrawer = true;
    }

    private async Task ReloadProduct()
    {
        Product =
            await ProductService
                .ObtenerProductoPorId(Id);
    }
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task DeleteProduct()
    {
        var success =
            await ProductService
                .EliminarProducto(Product.Id);

        if (success)
        {
            NavManager.NavigateTo("/inventario");
        }
    }
    private void CloseDeleteModal()
    {
        ShowDeleteModal = false;
    }
}