@page "/clientes"
@attribute [Authorize]
@layout DashboardLayout
@using InventarioSaaS.Web.Components.Customers
@using InventarioSaaS.Web.Services
@inject CustomerService CustomerService
@using InventarioSaaS.Web.Models.Customers
@using InventarioSaaS.Web.Models.Common
@using Microsoft.AspNetCore.Authorization
<div class="space-y-8">

    <!-- HEADER -->
    <div class="
        flex
        flex-col
        lg:flex-row
        lg:items-center
        lg:justify-between

        gap-6
        ">

        <!-- LEFT -->
        <div>

            <h1 class="
                text-4xl
                font-bold

                text-textPrimary
                dark:text-darkTextPrimary
                ">
                Clientes
            </h1>

            <p class="
                mt-2

                text-textMuted
                dark:text-darkTextMuted
                ">
                Gestiona clientes y relaciones comerciales.
            </p>

        </div>

        <!-- RIGHT -->
        <div class="
            flex
            flex-col
            sm:flex-row

            items-stretch
            sm:items-center

            gap-4
            ">

            <!-- SEARCH -->
            <div class="
                flex items-center gap-3

                h-14
                w-full
                sm:w-[320px]

                px-5

                rounded-2xl

                bg-surface
                dark:bg-darkSurface

                border
                border-borderColor
                dark:border-darkBorder
                ">

                🔍

                <input value="@Search"
                       @oninput="SearchChanged"
                       placeholder="Buscar cliente..."
                       class="
                bg-transparent
                outline-none
                flex-1
                text-textPrimary
                dark:text-darkTextPrimary
                " />

            </div>

            <!-- BUTTON -->
            <button @onclick="() => OpenCustomerDrawer = true"
                    class="
                h-14
                px-6

                rounded-2xl

                bg-primary
                hover:bg-primary-dark

                text-white
                font-semibold

                whitespace-nowrap

                transition-all
                hover:scale-[1.02]

                shadow-glow
                ">

                + Nuevo cliente

            </button>

        </div>

    </div>

    <!-- STATS -->
    <div class="
        grid
        grid-cols-1
        sm:grid-cols-2
        xl:grid-cols-4

        gap-6
        ">

        <!-- CARD -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft
            ">

            <p class="
                text-sm

                text-textMuted
                dark:text-darkTextMuted
                ">
                Clientes
            </p>

            <h3 class="
                mt-4

                text-4xl
                font-bold

                text-textPrimary
                dark:text-darkTextPrimary
                ">
                @TotalClientes
            </h3>

        </div>

        <!-- CARD -->
        @* <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft
            ">

            <p class="
                text-sm

                text-textMuted
                dark:text-darkTextMuted
                ">
                Nuevos este mes
            </p>

            <h3 class="
                mt-4

                text-4xl
                font-bold

                text-green-500
                ">
                +48
            </h3>

        </div>


        <!-- CARD -->
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[28px]

            p-6

            shadow-soft
            ">

            <p class="
                text-sm

                text-textMuted
                dark:text-darkTextMuted
                ">
                VIP
            </p>

            <h3 class="
                mt-4

                text-4xl
                font-bold

                text-orange-500
                ">
                18
            </h3>

        </div> *@

    </div>
    @if (Loading)
    {
        <div class="
            bg-surface
            dark:bg-darkSurface
            rounded-[32px]
            p-10
            text-center
            text-textMuted
            dark:text-darkTextMuted">

            Cargando clientes...

        </div>
    }
    else
    {
        <div class="
            bg-surface
            dark:bg-darkSurface

            border
            border-borderColor
            dark:border-darkBorder

            rounded-[32px]

            overflow-hidden

            shadow-soft
            ">

            <!-- HEADER -->
            <div class="
                grid
                grid-cols-[2fr_2fr_1fr_1fr]

                gap-4

                px-8 py-5

                border-b
                border-borderColor
                dark:border-darkBorder

                text-sm
                font-semibold

                text-textMuted
                dark:text-darkTextMuted
                ">

                <div>Cliente</div>
                <div>Dirección</div>
                <div>ID</div>
                <div class="text-right">Acciones</div>

            </div>

            <!-- ROWS -->
            <div class="
                divide-y
                divide-borderColor
                dark:divide-darkBorder
                ">

                @if (Customers.Count == 0)
                {
                    <div class="
                        p-16
                        text-center">

                        <div class="text-6xl">
                            👥
                        </div>

                        <h3 class="
                            mt-6
                            text-2xl
                            font-bold
                            text-textPrimary
                            dark:text-darkTextPrimary">

                            No hay clientes

                        </h3>

                        <p class="
                            mt-3
                            text-textMuted
                            dark:text-darkTextMuted">

                            Agrega tu primer cliente.

                        </p>

                    </div>
                }
                else
                {
                    @foreach (var customer in Customers)
                    {
                        <a href="/clientes/@customer.Id"
                           class="
                            grid
                            grid-cols-[2fr_2fr_1fr_1fr]

                            gap-4

                            px-8 py-5

                            items-center

                            hover:bg-surfaceSoft
                            dark:hover:bg-darkSurfaceSoft

                            transition-all
                            ">

                            <!-- CUSTOMER -->
                            <div class="flex items-center gap-4">

                                <!-- AVATAR -->
                                <div class="
                                    w-12 h-12

                                    rounded-2xl

                                    bg-gradient-to-br
                                    from-primary
                                    to-indigo-400

                                    flex items-center justify-center

                                    text-white
                                    font-bold
                                    ">

                                    @(customer.Nombre?.Substring(0, 1).ToUpper())

                                </div>

                                <div>

                                    <p class="
                                        font-semibold

                                        text-textPrimary
                                        dark:text-darkTextPrimary
                                        ">

                                        @customer.Nombre

                                    </p>

                                    <p class="
                                        text-sm

                                        text-textMuted
                                        dark:text-darkTextMuted
                                        ">

                                        @customer.NumeroTelefono

                                    </p>

                                </div>

                            </div>

                            <!-- DIRECCION -->
                            <div class="
                                text-textMuted
                                dark:text-darkTextMuted
                                ">

                                @customer.Direccion

                            </div>

                            <!-- ID -->
                            <div class="
                                text-textPrimary
                                dark:text-darkTextPrimary
                                ">

                                #@customer.Id

                            </div>

                            <!-- ACTION -->
                            <div class="flex justify-end">

                                <button @onclick:preventDefault
                                        class="
                                    w-10 h-10

                                    rounded-xl

                                    hover:bg-surfaceSoft
                                    dark:hover:bg-darkSurfaceSoft

                                    transition-all
                                    ">

                                    ⋮

                                </button>

                            </div>

                        </a>
                    }
                }

            </div>

            <!-- PAGINATION -->
            <div class="
                flex
                items-center
                justify-between

                px-8 py-6

                border-t
                border-borderColor
                dark:border-darkBorder
                ">

                <button @onclick="PreviousPage"
                        disabled="@(Loading || CurrentPage <= 1)"
                        class="
                    px-5 py-3
                    rounded-2xl

                    border border-borderColor

                    bg-surface
                    dark:bg-darkSurface

                    disabled:opacity-50
                    ">

                    ← Anterior

                </button>

                <p class="
                    text-sm

                    text-textMuted
                    dark:text-darkTextMuted
                    ">

                    Página @CurrentPage de @TotalPages

                </p>

                <button @onclick="NextPage"
                        disabled="@(Loading || CurrentPage >= TotalPages)"
                        class="
                    px-5 py-3
                    rounded-2xl

                    bg-primary

                    text-white

                    disabled:opacity-50
                    ">

                    Siguiente →

                </button>

            </div>

        </div>
    }
</div>

<CustomerDrawer
    Open="OpenCustomerDrawer"
    OpenChanged="@(value => OpenCustomerDrawer = value)"
    OnSaved="LoadCustomers" />

@code {

    private bool OpenCustomerDrawer;

    private string Search = "";

    private bool Loading = true;

    private List<CustomerDto> Customers = [];

    private int CurrentPage = 1;

    private int TotalPages;

    private int TotalClientes =>
    Customers.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        Loading = true;

        var response =
            await CustomerService.ObtenerClientes(
                page: CurrentPage,
                pageSize: 10,
                search: Search);

        if (response is not null)
        {
            Customers = response.Data;

            TotalPages = response.TotalPages;
        }

        Loading = false;
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        CurrentPage++;

        await LoadCustomers();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        CurrentPage--;

        await LoadCustomers();
    }
    private async Task SearchChanged(ChangeEventArgs e)
    {
        Search = e.Value?.ToString() ?? "";

        CurrentPage = 1;

        await LoadCustomers();
    }

}